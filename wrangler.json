{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quickews",
  "main": "src/index.js",
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2025-08-21",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quickews-d1",
      "database_id": "d03bd56b-e1be-455f-9cd5-d48ca52471f1",
      "migrations_dir": "drizzle"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "29c02de9806c400f962b1dc9f1507636"
    }
  ]


